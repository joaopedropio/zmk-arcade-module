if SHIELD_ARCADE_ADAPTER

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    default y

config ZMK_DISPLAY
    default y

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_USE_FLEX
    select ZMK_WPM

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

config ZMK_DISPLAY_DEDICATED_THREAD_STACK_SIZE
    default 4096

# The splash, the dashboard's slots and its animated header all draw through
# scaled bitmap buffers taken from the kernel heap - 12.3 KB of them for the
# default two-slot layout, and about 16 KB if slot 2 is given one of the big
# scale-9 fonts.  Zephyr's 8 KB is not enough for that: k_malloc() starts
# returning NULL and the widgets that got nothing simply do not draw.  The
# arcade dashboard adds ~5.6 KB of its own (its fill strip and its score-digit
# scratch), the profile-switch modal ~4 KB, and the splash is still allocated
# during init - so 16 KB overflowed and the dashboard came up blank.  32 KB
# clears the peak with the big-font layout and leaves a few KB in hand.
config HEAP_MEM_POOL_SIZE
    default 32768

choice ST7789V_PIXEL_FORMAT
    default ST7789V_RGB565
endchoice

# Nothing is drawn through LVGL - the status screen is an empty lv_obj and the
# game, the splash and the dashboard all write straight to the panel - so its
# rendering buffer only ever flushes that empty screen.  At 100 (percent of
# the display) it was 112 KB of RAM doing nothing; 10 is Zephyr's own default
# and still more than an empty screen needs.  The object pool is one object.
config LV_Z_VDB_SIZE
    default 10

config LV_Z_MEM_POOL_SIZE
    default 4096

config LV_DPI_DEF
    default 261

config LV_Z_BITS_PER_PIXEL
    default 16

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_16
endchoice

config LV_COLOR_16_SWAP
    default n

config LV_DEF_REFR_PERIOD
    default 20

choice LV_FONT_DEFAULT
    default LV_FONT_DEFAULT_MONTSERRAT_20
endchoice

config MIPI_DBI
    default y

config PWM
    default y

config LED_PWM
    default y

endif
